{
  "openapi": "3.0.3",
  "info": {
    "title": "BoardRaid Public Read API",
    "version": "0.5.5",
    "description": "源码核对的只读子集；非稳定性 SLA。新增字段应忽略，个人资料示例不使用真实玩家。"
  },
  "servers": [
    {
      "url": "https://api.boardraid.cn"
    }
  ],
  "paths": {
    "/api/status": {
      "get": {
        "summary": "公开服务状态",
        "responses": {
          "200": {
            "description": "状态对象；字段可能随版本扩展",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "onlinePlayers": {
                      "type": "integer"
                    },
                    "playingMatches": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "请求过多；退避后重试"
          },
          "503": {
            "description": "维护或服务暂不可用；不要高频重试"
          }
        }
      }
    },
    "/api/leaderboard": {
      "get": {
        "summary": "公开积分榜，不包含隐藏匹配分",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok、entries、total、totalProfiles；total 为已定级人数"
          },
          "429": {
            "description": "请求过多；退避后重试"
          },
          "503": {
            "description": "维护或服务暂不可用；不要高频重试"
          }
        }
      }
    },
    "/api/player": {
      "get": {
        "summary": "以当前昵称查询公开资料及历史",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 32
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok、query、found；found=true 时有 profile/history，未找到使用 found=false"
          },
          "429": {
            "description": "请求过多；退避后重试"
          },
          "503": {
            "description": "维护或服务暂不可用；不要高频重试"
          }
        }
      }
    },
    "/api/head": {
      "get": {
        "summary": "按昵称获取 PNG 头像",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 32
            }
          }
        ],
        "responses": {
          "200": {
            "description": "头像 PNG",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "头像不可用"
          },
          "429": {
            "description": "请求过多；退避后重试"
          },
          "503": {
            "description": "维护或服务暂不可用；不要高频重试"
          }
        }
      }
    }
  }
}
